# Juval — variables de entorno (plantilla, sin valores reales)
#
# Copiar a .env (ignorado por Git, ver .gitignore) y completar con
# valores reales SOLO en el entorno donde corran los procesos que los
# necesitan. Nunca commitear un .env con valores reales.

# --- interfaces/api (backend FastAPI, Fase 4A) -----------------------

# Directorio base para archivos temporales de una corrida (Excel subido
# + Excel generado). Opcional -- si no se define, usa el directorio
# temporal del sistema. Ver docs/architecture/API_CONTRACT.md §6.
JUVAL_RUN_STORAGE_DIR=

# Límite técnico de tamaño de archivo subido, en bytes. Opcional -- si
# no se define, no se impone ningún límite (mismo comportamiento que el
# Core ya tenía). El valor comercial definitivo sigue PENDIENTE, ver
# docs/architecture/SECURITY.md §3 y API_CONTRACT.md §4. NO copiar aquí
# un número inventado.
JUVAL_MAX_UPLOAD_BYTES=

# Orígenes permitidos para CORS, separados por coma. Vacío por defecto
# (ningún origen permitido). Nunca usar "*". En Railway (ADR-018),
# configurar con la URL real que Vercel asigne al frontend una vez
# desplegado -- esa URL no existe todavía, no inventarla aquí.
JUVAL_CORS_ORIGINS=

# NO establecer manualmente en Railway -- Railway inyecta PORT
# automáticamente y railway.toml::startCommand ya lo usa
# (--port $PORT). Documentado aquí solo para que no se confunda con
# una variable que el operador deba configurar.
# PORT=(gestionado por Railway)

# Selector explícito de ExecutionRunStore (ADR-017), valores válidos:
# "sqlite" | "supabase". Es la fuente de verdad cuando está definida --
# nunca se infiere del store a partir de qué variable de conexión está
# presente (así una JUVAL_SUPABASE_DB_URL o JUVAL_EXECUTION_DB_PATH
# heredada en un .env de desarrollo no puede redirigir en silencio la
# selección). Un valor fuera de {"sqlite","supabase"}, o la ausencia de
# la variable de conexión que el modo elegido requiere, falla
# explícitamente (ver interfaces/api/main.py::_execution_run_store).
# Sin definir, se mantiene el comportamiento legacy: SqliteExecutionRunStore
# si JUVAL_EXECUTION_DB_PATH está definida, si no, sin store configurado.
# Producción (Railway, ADR-018) NO debe depender del modo legacy --
# debe fijar JUVAL_EXECUTION_STORE=supabase explícitamente.
JUVAL_EXECUTION_STORE=

# Ruta a un archivo SQLite para persistir ExecutionRun localmente
# (ADR-013). Requerida cuando JUVAL_EXECUTION_STORE=sqlite, u opcional
# en modo legacy (JUVAL_EXECUTION_STORE sin definir) para invocar la
# API con persist=true en desarrollo/local.
JUVAL_EXECUTION_DB_PATH=

# --- Supabase / PostgreSQL (persistencia de producción, ADR-017) -----
# Proyecto real ya verificado -- ver docs/architecture/SUPABASE.md §1.

# Pública (segura de exponer al frontend) -- URL del proyecto Supabase.
SUPABASE_URL=

# Pública (segura de exponer al frontend) -- protegida por Row Level
# Security (ver supabase/migrations/20260817000000_execution_runs.sql).
SUPABASE_ANON_KEY=

# SECRETA -- SOLO backend. Nunca en un build de frontend (nunca con
# prefijo VITE_ ni equivalente). Nunca en Git.
SUPABASE_SERVICE_ROLE_KEY=

# Connection string de Postgres para SupabaseExecutionRunStore
# (ADR-017). Requerida cuando JUVAL_EXECUTION_STORE=supabase. SOLO
# backend. Nunca en Git. Usar el Connection Pooler de Supabase
# (host tipo aws-0-<region>.pooler.supabase.com), no el host de
# conexión directa -- el host directo resuelve solo por IPv6 en
# proyectos nuevos, ver docs/architecture/SUPABASE.md §1.
JUVAL_SUPABASE_DB_URL=

# --- Frontend (React + Vite, Fase 4B -- NO implementado todavía) -----
# Documentado aquí como referencia de qué NO debe contener nunca una
# service role key -- ninguna variable VITE_* debe llevar secretos de
# backend, ver docs/architecture/SUPABASE.md §5.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
