# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Secrets -- never committed, .env.example is the only tracked template
.env
.env.*
!.env.example
!frontend/.env.example

# Frontend (Node/Vite)
node_modules/
frontend/dist/
frontend/dev-dist/

# Playwright
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Temporary run storage (Fase 4A, interfaces/api -- never permanent, see
# docs/architecture/API_CONTRACT.md §6)
juval_runs/

# Supabase CLI local link state (project-ref only, no secrets -- still
# machine-local, never versioned, see docs/architecture/SUPABASE.md)
supabase/.temp/

# IDE / local artifacts, logs
.vscode/
.idea/
*.log

# Local E2E SQLite database -- generated by the documented Playwright run
# (JUVAL_EXECUTION_DB_PATH=./e2e_runs.db, see frontend/e2e/README.md), never
# a source artifact.
e2e_runs.db

# Local execution-run SQLite store: the conventional filename used when
# running the backend or CLI locally with JUVAL_EXECUTION_DB_PATH=./juval_runs.db
# (API) or --persist-db (CLI). Neither entrypoint ever creates it implicitly --
# both require the path to be given -- but that name is what the local docs use,
# so it is ignored like e2e_runs.db above. Generated runtime state (tables:
# execution_runs, execution_run_records, batches, batch_files), never a source
# artifact. Deliberately a single filename, not a *.db pattern, so a legitimate
# committed database artifact could never be hidden by this rule.
juval_runs.db

# Claude Code agent skill packs and scheduler state -- machine-local tooling,
# not JUVAl project configuration. CLAUDE.md at the repo root is the tracked
# contract.
.claude/
