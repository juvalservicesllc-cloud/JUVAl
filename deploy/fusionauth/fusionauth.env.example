# JUVAl — identity environment, names and placeholders only.
#
# NOTHING in this file is a real value. Copy it, fill the copy in on the host
# that needs it, and never commit the copy. `tools/compliance_check.py`'s
# secret scan runs over this repository on every compliance pass.
#
# Where each of these actually lives is the point of the table in
# docs/compliance/IDENTITY_DEPLOYMENT_FUSIONAUTH.md §6 — this file only names
# them so nothing has to be guessed at deployment time.

# --- juval-server: FusionAuth itself ---------------------------------------
# Written by deploy/fusionauth/install.sh into
# /usr/local/fusionauth/config/fusionauth.properties (0600, fusionauth:root).
# It is NOT read from a file like this one; listed here only so the inventory
# of identity secrets is complete.
#   database.password=<generated by install.sh, never chosen by hand>

# --- operator workstation: running tools/verify_oidc.py --tenant-policy -----
# A FusionAuth API key with read access to the Tenants API. Passed in the
# environment because an argument would land in shell history.
JUVAL_IDP_API_KEY=__fusionauth_api_key__

# --- Railway (backend), set in the Railway dashboard, never in this repo ----
# Order matters: JUVAL_AUTH_MODE must stay `disabled` until the issuer is
# reachable and tools/verify_oidc.py passes against it. Setting it to `oidc`
# with no reachable issuer breaks every request (SECRETS.md §8 S-4).
JUVAL_AUTH_MODE=disabled
JUVAL_OIDC_ISSUER=__https_public_issuer_url__
JUVAL_OIDC_AUDIENCE=__fusionauth_application_client_id__
JUVAL_OIDC_ROLES_CLAIM=roles
# Only needed if a provider deviates from the OIDC Discovery convention.
# FusionAuth does not, so leave this unset.
# JUVAL_OIDC_JWKS_URI=
